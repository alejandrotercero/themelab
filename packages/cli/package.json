{
  "name": "themelab-cli",
  "version": "0.2.1",
  "description": "Visual overlay for React dev servers — select components, drag to reorder, and draw on a Figma-style canvas",
  "keywords": [
    "react",
    "devtools",
    "visual",
    "overlay",
    "figma",
    "component",
    "drag-and-drop",
    "jsx",
    "ast",
    "cli"
  ],
  "homepage": "https://github.com/alejandrotercero/themelab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alejandrotercero/themelab.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Alejandro <alextlopez11@gmail.com>",
  "bin": {
    "themelab": "bin/themelab.js"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "node ../../scripts/embed-overlay.mjs && tsc && cp ../overlay/dist/overlay.js dist/overlay.js",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm run test:run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.4.0",
    "commander": "^13.0.0",
    "http-proxy-3": "^1.23.3",
    "jscodeshift": "^17.1.0",
    "open": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "ws": "^8.21.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@themelab/core": "workspace:*",
    "@themelab/shared": "workspace:*",
    "@types/jscodeshift": "^17.3.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
