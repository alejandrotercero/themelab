{
  "name": "themelab-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm build:shared && pnpm build:core && pnpm build:overlay && pnpm build:cli",
    "build:shared": "pnpm --filter @themelab/shared build",
    "build:core": "pnpm --filter @themelab/core build",
    "build:overlay": "pnpm --filter @themelab/overlay build",
    "build:cli": "pnpm --filter themelab-cli build",
    "build:desktop": "pnpm --filter @themelab/desktop build",
    "gen:overlay": "node scripts/embed-overlay.mjs",
    "_bin:prep": "pnpm build:overlay && pnpm gen:overlay",
    "build:bin": "pnpm _bin:prep && bun build packages/cli/src/index.ts --compile --outfile dist/themelab",
    "build:bin:darwin-arm64": "pnpm _bin:prep && bun build packages/cli/src/index.ts --compile --target=bun-darwin-arm64 --outfile dist/themelab-darwin-arm64",
    "build:bin:darwin-x64": "pnpm _bin:prep && bun build packages/cli/src/index.ts --compile --target=bun-darwin-x64 --outfile dist/themelab-darwin-x64",
    "build:bin:linux-x64": "pnpm _bin:prep && bun build packages/cli/src/index.ts --compile --target=bun-linux-x64 --outfile dist/themelab-linux-x64",
    "build:bin:linux-arm64": "pnpm _bin:prep && bun build packages/cli/src/index.ts --compile --target=bun-linux-arm64 --outfile dist/themelab-linux-arm64",
    "build:bin:windows-x64": "pnpm _bin:prep && bun build packages/cli/src/index.ts --compile --target=bun-windows-x64 --outfile dist/themelab-windows-x64.exe",
    "build:bin:all": "pnpm _bin:prep && bun build packages/cli/src/index.ts --compile --target=bun-darwin-arm64 --outfile dist/themelab-darwin-arm64 && bun build packages/cli/src/index.ts --compile --target=bun-darwin-x64 --outfile dist/themelab-darwin-x64 && bun build packages/cli/src/index.ts --compile --target=bun-linux-x64 --outfile dist/themelab-linux-x64 && bun build packages/cli/src/index.ts --compile --target=bun-linux-arm64 --outfile dist/themelab-linux-arm64 && bun build packages/cli/src/index.ts --compile --target=bun-windows-x64 --outfile dist/themelab-windows-x64.exe",
    "install:bin": "pnpm build:bin && node scripts/install-bin.mjs",
    "dev": "pnpm _bin:prep && pnpm --filter themelab-cli dev",
    "dev:web": "pnpm --filter @themelab/web dev",
    "dev:desktop": "pnpm --filter @themelab/desktop dev",
    "build:web": "pnpm --filter @themelab/web build",
    "typecheck": "pnpm build:shared && pnpm --filter themelab-cli --filter @themelab/overlay exec tsc --noEmit",
    "typecheck:web": "pnpm --filter @themelab/web typecheck",
    "typecheck:theme-engine": "pnpm --filter @themelab/theme-engine typecheck",
    "typecheck:core": "pnpm --filter @themelab/core typecheck",
    "typecheck:theme-ui": "pnpm --filter @themelab/theme-ui typecheck",
    "lint:web": "pnpm --filter @themelab/web lint",
    "check:web": "pnpm typecheck:web && pnpm lint:web",
    "lint:oxc": "sh -c 'status=0; for scope in web cli overlay shared; do pnpm \"lint:oxc:$scope\" || status=1; done; exit $status'",
    "lint:oxc:web": "oxlint --config apps/web/oxlint.config.mjs apps/web",
    "lint:oxc:cli": "oxlint --config packages/cli/oxlint.config.mjs packages/cli/src",
    "lint:oxc:overlay": "oxlint --config packages/overlay/oxlint.config.mjs packages/overlay/src",
    "lint:oxc:shared": "oxlint --config packages/shared/oxlint.config.mjs packages/shared/src",
    "format:check:oxc": "oxfmt --config oxfmt.config.mjs --check \"apps/web/**/*.{ts,tsx}\" \"packages/{cli,overlay,shared}/src/**/*.{ts,tsx}\"",
    "check:oxc": "pnpm lint:oxc && pnpm format:check:oxc",
    "test": "pnpm --filter themelab-cli test",
    "test:theme-engine": "pnpm --filter @themelab/theme-engine test",
    "test:core": "pnpm --filter @themelab/core test",
    "test:desktop-lifecycle": "pnpm --filter @themelab/desktop test:lifecycle",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@strastdas/oxc-config": "0.1.2",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "ultracite": "7.9.4"
  }
}
