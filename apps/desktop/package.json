{
  "name": "@themelab/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm --filter @themelab/shared build && pnpm --filter @themelab/core build && pnpm --filter @themelab/overlay build && pnpm --filter themelab-cli build && tsc -p tsconfig.main.json && vite build && node scripts/copy-static.mjs",
    "dev": "pnpm run build && electron dist/main.js",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "culori": "^4.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "@themelab/shared": "workspace:*",
    "@themelab/theme-engine": "workspace:*",
    "@themelab/core": "workspace:*",
    "@themelab/theme-ui": "workspace:*",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/culori": "^2.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.4.1",
    "@types/node": "^22",
    "electron": "^38.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
